# Copy to .env and fill in. .env is git-ignored and never committed.
# Use ONE of the two blocks below, depending on where this copy runs.

# --- On a PC: npm run dev / npm run serve ------------------------------------
PUTER_DIR=C:\path\to\your\PUTER\folder
PORT=3001
PUTER_TZ=America/New_York # IANA tz name — used for the 4am daily-state rollover

# --- On the server: docker compose up -----------------------------------------
# Compose reads these from the .env beside compose.yaml. On the server, delete
# the PC block above and uncomment these. Every value here is an example.
# PUTER_HOME=/srv/puter       # host directory holding data/, state/, backups/, certs/
# PUTER_BIND=10.0.0.1         # host address the proxy listens on — required
# PUTER_URL=https://10.0.0.1  # the address you open; printed at startup
# PUTER_TZ=America/New_York
