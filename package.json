{
  "name": "puter-app",
  "version": "0.3.0",
  "description": "P.U.T.E.R. — local read-only dashboard, installable PWA",
  "private": true,
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm run server\" \"npm run client\"",
    "server": "node server/index.js",
    "client": "npm run dev --prefix client",
    "build": "npm run build --prefix client",
    "serve": "npm run build && node server/index.js",
    "install:all": "npm install && npm install --prefix client",
    "gen:icons": "node scripts/gen-icons.js"
  },
  "dependencies": {
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2"
  },
  "engines": {
    "node": ">=18"
  }
}
